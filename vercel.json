{
  "version": 2,
  "installCommand": "npm ci --no-audit --no-fund",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server.ts", "server/**/*.ts"]
      }
    },
    {
      "src": "api/navigation.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/trace-summary.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npm run lint && npm run build",
        "installCommand": "npm ci --no-audit --no-fund"
      }
    }
  ],
  "routes": [
    { "src": "/api/ai/navigation-guidance", "dest": "/api/navigation.ts" },
    { "src": "/api/traces/summary", "dest": "/api/trace-summary.ts" },
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
